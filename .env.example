# =============================================================================
# async-trading-engine — .env template
# Copy to .env at the project root and fill in required values, or run the
# guided first-time setup:  uv run python scripts/setup.py
# Lines starting with # are comments. Remove the # to activate a setting.
# =============================================================================

# =============================================================================
# === Broker ===
# =============================================================================

# Active broker. "ig" (IG Group spread betting) is the only supported value.
BROKER=ig

# Bot environment: "demo" or "live". Start with demo.
BOT_ENV=demo

# =============================================================================
# === IG Group credentials (required) ===
# =============================================================================

# Demo account (BOT_ENV=demo)
IG_DEMO_API=
IG_DEMO_USERNAME=
IG_DEMO_PASSWORD=

# Live account (BOT_ENV=live) — leave empty until ready for live trading
IG_LIVE_API=
IG_LIVE_USERNAME=
IG_LIVE_PASSWORD=

# EPICs for order placement (required only when CANDLE_EXCHANGE=ig).
#IG_EPICS=["CS.D.EURUSD.TODAY.IP"]

# =============================================================================
# === Candle data source ===
# =============================================================================

# "eodhd"      — EODHD intraday backfill + WebSocket aggregated to 1h
#                (primary; sources the full 28-asset universe)
# "twelvedata" — Twelve Data REST hourly OHLC (FX-only warm-standby failover)
# "ig"         — IG Lightstreamer (requires IG_EPICS)
CANDLE_EXCHANGE=eodhd

# Candle timeframe string stored in the DB (informational — feed determines actual interval)
CANDLE_TIMEFRAME=1h

# In-memory candle buffer per symbol
#CANDLE_BUFFER_SIZE=3000

# =============================================================================
# === EODHD (required when CANDLE_EXCHANGE=eodhd) ===
# =============================================================================

# Key from eodhd.com — needs the intraday-historical + real-time WebSocket plan.
EODHD_API=

# =============================================================================
# === Twelve Data (required when CANDLE_EXCHANGE=twelvedata) ===
# =============================================================================

# Free-tier key from twelvedata.com — 8 credits/min supports the 12-pair FX standby
TWELVE_DATA_API=

# =============================================================================
# === Kronos model (required when TOPK_ENABLED=true) ===
# =============================================================================

# Absolute path to a checkout of the Kronos repository
# (https://github.com/shiyu-coder/Kronos — the directory containing model/).
# Weights download automatically from HuggingFace on first run.
KRONOS_DIR=

# HuggingFace model IDs — change only if switching to a different Kronos variant
#KRONOS_MODEL=NeoQuasar/Kronos-mini
#KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-2k

# Context bars fed to Kronos (Tokenizer-2k supports up to 2048; 400 bars = ~17 days of 1h bars)
#KRONOS_CONTEXT_BARS=400

# =============================================================================
# === TopK strategy ===
# =============================================================================

# Enable the Kronos TopK multi-asset strategy
TOPK_ENABLED=true

# Symbols to scan; leave empty to use the full built-in 28-asset universe
#TOPK_WATCHLIST=[]

# Symbols scored and logged but never selected for entry (paper-watch list)
#TOPK_EXCLUDE_FROM_SELECTION=[]

# Maximum simultaneous open positions
#TOPK_K=3

# How often to re-rank the watchlist (minutes)
#TOPK_RERANK_INTERVAL_MINUTES=60

# Input resampling before Kronos. Must be 1 for eodhd/twelvedata (both deliver 1h bars).
TOPK_AGGREGATE_TO_MINUTES=1

# Prediction horizon in bars (120 x 1h = 5-day horizon)
#TOPK_PRED_LEN=120

# --- Inference hyperparameters (Kronos paper defaults) ---
# Pass 1 (point estimate): low temperature for sharp directional signal
#TOPK_FORECAST_TEMPERATURE=0.6
#TOPK_FORECAST_TOP_P=0.9
#TOPK_FORECAST_SAMPLE_COUNT=10

# Pass 2 (variance estimate): high temperature preserves Monte-Carlo spread
#TOPK_VARIANCE_PASS_ENABLED=true
#TOPK_VARIANCE_TEMPERATURE=1.0
#TOPK_VARIANCE_SAMPLE_COUNT=20

# --- Signal-quality entry filters ---
# The defaults are deliberately WIDE, uncalibrated starting points — they only
# reject degenerate signals. Once the bot has accumulated a few weeks of
# signal_history, calibrate these against your own data:
#     uv run python scripts/calibrate_thresholds.py --help
#
#   TOPK_MIN_CONFIDENCE        range 0.50–0.95   (fraction of MC paths agreeing)
#   TOPK_MAX_UNCERTAINTY       range 1.0–100.0   (std/|mean| return cap)
#   TOPK_MIN_PREDICTED_RETURN  range 0.0–0.02    (predicted-return floor)
#TOPK_MIN_CONFIDENCE=0.60
#TOPK_MAX_UNCERTAINTY=5.0
#TOPK_MIN_PREDICTED_RETURN=0.001

# --- Stop sizing ---
#TOPK_VOL_STOP_MULTIPLIER=2.0
#TOPK_MIN_STOP_PCT=0.005

# --- Correlation filter ---
# Skip candidates whose |Pearson| correlation with an already-selected symbol
# exceeds the threshold. Range 0.5–1.0; 1.0 disables the filter entirely.
#TOPK_CORRELATION_MAX=0.75
#TOPK_CORRELATION_LOOKBACK_BARS=200
# Long-only book: bump on positive correlation only, keeping negatively-
# correlated (hedging) candidates.
#TOPK_CORRELATION_LONG_ONLY=false

# --- Ranking horizon ---
# Bar of the Pass-1 path used as the ranking signal. 0 = terminal bar
# (ranking pegged to TOPK_PRED_LEN). A shorter horizon costs no extra
# inference — the full path is already generated by Pass 1.
#TOPK_RANKING_HORIZON_BARS=0

# Per-asset-class override of the global horizon ("class:bars" pairs, comma-
# separated; classes: forex, metal, us_equity). Empty = the global scalar
# applies to all. Validated at startup. Changing the horizon shifts the
# signal distribution — couple any change with a threshold recalibration.
#TOPK_RANKING_HORIZON_BY_CLASS=

# Run the two inference groups concurrently on multi-core hosts
#TOPK_PARALLEL_GROUPS=false

# =============================================================================
# === Risk management ===
# =============================================================================

# Fraction of equity risked per trade (e.g. 0.01 = 1%)
#RISK_PER_TRADE_PCT=0.01

# Hard cap: refuse new orders when margin > this fraction of equity
#MAX_MARGIN_PCT=0.50

# Drawdown tiers — reduce/halt trading as drawdown deepens
#DRAWDOWN_YELLOW_PCT=0.05
#DRAWDOWN_ORANGE_PCT=0.10
#DRAWDOWN_RED_PCT=0.15

# Daily/weekly/monthly loss limits (fraction of equity)
#DAILY_LOSS_LIMIT_PCT=0.03
#WEEKLY_LOSS_LIMIT_PCT=0.05
#MONTHLY_LOSS_LIMIT_PCT=0.10

# Pause trading after N consecutive losing trades
#CONSECUTIVE_LOSS_PAUSE=4

# =============================================================================
# === Take-profit (five independent exit components) ===
# =============================================================================

# Static TP — path-aware when a Kronos path signal is available
#TP_STATIC_ENABLED=true

# Trailing stop — Stage 1 breakeven + Stage 2 ratchet
#TP_TRAILING_ENABLED=true

# Signal decay — close when the Kronos signal weakens over successive reranks
#TP_SIGNAL_DECAY_ENABLED=true

# Time exit — closes after predicted peak bar + grace, or pred_len x multiplier
#TP_TIME_ENABLED=true

# Sentiment reversal — requires SENTIMENT_ENABLED=true
#TP_SENTIMENT_REVERSAL_ENABLED=false

# Reward:risk minimum for static TP target
#TP_MIN_RR_MULTIPLIER=1.5

# Fraction of mean_return used as TP target when no path signal is available
#TP_KRONOS_TARGET_FRACTION=0.80

# Trailing stop parameters
#TP_BREAKEVEN_ACTIVATION_MULT=1.0
#TP_BREAKEVEN_BUFFER=0.001
#TP_TRAIL_ACTIVATION_MULT=2.0
#TP_TRAIL_MULTIPLIER=0.5

# Signal decay parameters
#TP_SIGNAL_DECAY_MIN_CONFIDENCE=0.55
#TP_SIGNAL_DECAY_MAX_UNCERTAINTY=3.0
#TP_SIGNAL_DECAY_MAX_STRIKES=2

# Time exit: multiplier applied to pred_len when no path signal is available
#TP_TIME_HORIZON_MULTIPLIER=1.0

# Sentiment reversal parameters
#TP_SENTIMENT_REVERSAL_THRESHOLD=-0.3
#TP_SENTIMENT_REVERSAL_MIN_CONFIDENCE=0.6

# =============================================================================
# === Sentiment overlay (optional, off by default) ===
# =============================================================================

#SENTIMENT_ENABLED=false
#SENTIMENT_SCAN_INTERVAL_MINUTES=30
#SENTIMENT_ESCALATION_MAX_PER_HOUR=20

# Gate TopK entries on sentiment (direction-aware thresholds)
#SENTIMENT_GATE_ENABLED=false
#SENTIMENT_GATE_LONG_THRESHOLD=0.3
#SENTIMENT_GATE_SHORT_THRESHOLD=-0.3

# Groq API key — bulk sentiment LLM (free tier available)
#GROQ_API=

# Gemini API key — escalation LLM for high-disagreement cases
#GEMINI_API_KEY=

# Finnhub API key (news/economic calendar)
#FINHUB_IO_API=

# FinBERT local headline pre-filter — ProsusAI/finbert via ONNX. CPU-only,
# ~500 MB resident; disabled by default (contends with Kronos inference).
#FINBERT_ENABLED=false

# =============================================================================
# === Macro overlay (optional) ===
# =============================================================================

# FRED API key — free signup at fred.stlouisfed.org/docs/api/api_key.html
# Used for the macro feature loop (DXY, VIX, yields, CPI, NFP).
#FRED_API_KEY=

# =============================================================================
# === Logging and monitoring ===
# =============================================================================

#LOG_LEVEL=INFO

# Healthchecks-style URL — GET pinged every 60s while the bot is alive
#HEALTHCHECK_URL=

# =============================================================================
# === Telegram alerts (optional) ===
# TELEGRAM_CHAT_ID: numeric chat ID (get from @userinfobot)
# TELEGRAM_BOT_TOKEN: token from @BotFather
# =============================================================================

TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
